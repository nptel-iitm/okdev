#!/usr/bin/env python3
"""Durable run state for OKDev workflows under Codex.

Why this exists
---------------
GPT-5.6's harness drops a skill between turns unless it is re-mentioned, and
compacts the conversation when context fills - telling the model to "continue
naturally" afterwards. Any loop counter that lives only in the model's head is
therefore lost exactly when a long workflow needs it most, and the phase
restarts. That is the mechanism behind the never-ending kickoff and bugfix runs
reported in issue #15.

So the count lives on disk, and exhausting a loop is reported as a process exit
code rather than as a sentence the model has to remember to obey:

    okdev-state loop-bump review:issue-12 --limit 3
      exit 0  -> keep going, prints the remaining rounds
      exit 3  -> budget spent, stop the loop and record a blocker

`okdev-state next` prints the single next action for the current state, which
lets a skill resume correctly after compaction by reading one line.

State lives at .okdev/run-state.json in the project being built.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

SCHEMA = 1
LOOP_EXHAUSTED = 3


def state_path(root: Path) -> Path:
    return root / ".okdev" / "run-state.json"


def load(root: Path) -> dict:
    path = state_path(root)
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        # A corrupt state file must be loud: silently starting over is the
        # exact failure this file exists to prevent.
        sys.exit(f"okdev-state: {path} is not valid JSON ({exc}). Repair it before continuing.")


def save(root: Path, state: dict) -> None:
    path = state_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    state["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.replace(path)


def require(state: dict) -> dict:
    if not state:
        sys.exit("okdev-state: no run state. Run `okdev-state init --workflow <name>` first.")
    return state


def cmd_init(root: Path, args) -> int:
    existing = load(root)
    if existing and not args.force:
        # Re-entering an existing run is the normal case after a compaction.
        print(json.dumps(existing, indent=2))
        return 0
    save(root, {
        "schema": SCHEMA,
        "workflow": args.workflow,
        "status": "running",
        "phase": args.phase,
        "phases_done": [],
        "loops": {},
        "notes": {},
        "blocked": None,
    })
    print(json.dumps(load(root), indent=2))
    return 0


def cmd_get(root: Path, args) -> int:
    state = require(load(root))
    if args.key:
        value = state
        for part in args.key.split("."):
            value = (value or {}).get(part) if isinstance(value, dict) else None
        print(json.dumps(value) if not isinstance(value, str) else value)
    else:
        print(json.dumps(state, indent=2))
    return 0


def cmd_set_phase(root: Path, args) -> int:
    state = require(load(root))
    previous = state.get("phase")
    if previous and previous != args.phase and previous not in state["phases_done"]:
        state["phases_done"].append(previous)
    state["phase"] = args.phase
    save(root, state)
    print(f"phase: {previous} -> {args.phase}")
    return 0


def cmd_loop_bump(root: Path, args) -> int:
    state = require(load(root))
    loop = state["loops"].setdefault(args.key, {"rounds": 0, "limit": args.limit})
    loop["limit"] = args.limit
    loop["rounds"] += 1
    save(root, state)

    if loop["rounds"] > args.limit:
        print(
            f"loop '{args.key}' exhausted: {loop['rounds'] - 1} rounds completed, "
            f"limit is {args.limit}. Stop looping and record a blocker.",
            file=sys.stderr,
        )
        return LOOP_EXHAUSTED
    print(f"loop '{args.key}' round {loop['rounds']} of {args.limit}")
    return 0


def cmd_loop_reset(root: Path, args) -> int:
    state = require(load(root))
    state["loops"].pop(args.key, None)
    save(root, state)
    print(f"loop '{args.key}' reset")
    return 0


def cmd_note(root: Path, args) -> int:
    state = require(load(root))
    state["notes"][args.key] = args.value
    save(root, state)
    print(f"note {args.key} recorded")
    return 0


def cmd_block(root: Path, args) -> int:
    """Record a terminal blocked state and write the human-readable handoff."""
    state = require(load(root))
    state["status"] = "blocked"
    state["blocked"] = {"phase": state.get("phase"), "reason": args.reason}
    save(root, state)

    report = root / ".okdev" / "blocked.md"
    report.write_text(
        f"# Blocked: {state.get('workflow')} / {state.get('phase')}\n\n"
        f"{args.reason}\n\n"
        "## What was completed\n\n"
        + "".join(f"- {phase}\n" for phase in state.get("phases_done", []) or ["nothing yet"])
        + "\n## Loop budgets at the time of blocking\n\n"
        + "".join(
            f"- {key}: {min(loop['rounds'], loop['limit'])} of {loop['limit']} rounds\n"
            for key, loop in state.get("loops", {}).items()
        )
        + "\n## To resume\n\n"
        "Resolve the blocker, then re-invoke the same skill. It reads\n"
        "`.okdev/run-state.json` and continues from the recorded phase.\n"
    )
    print(f"blocked recorded; handoff written to {report}")
    return 0


def cmd_complete(root: Path, args) -> int:
    state = require(load(root))

    # A worker skill running inside an orchestrator shares the project's state
    # file. It must record its own completion without declaring the whole
    # workflow finished, so `complete --workflow <own-name>` is a no-op on the
    # workflow status unless this skill is the one that started the run.
    if args.workflow and state.get("workflow") != args.workflow:
        state["notes"][f"task:{args.workflow}"] = "complete"
        save(root, state)
        print(f"task '{args.workflow}' complete; workflow '{state.get('workflow')}' still running")
        return 0

    state["status"] = "complete"
    if state.get("phase") and state["phase"] not in state["phases_done"]:
        state["phases_done"].append(state["phase"])
    state["phase"] = "complete"
    save(root, state)
    print("workflow complete")
    return 0


def cmd_next(root: Path, args) -> int:
    """One line describing where the workflow stands. Read this after a compaction."""
    state = load(root)
    if not state:
        print("no run state - this workflow has not started")
        return 0
    if state["status"] == "complete":
        print("complete - nothing left to do")
        return 0
    if state["status"] == "blocked":
        print(f"blocked at phase '{state['phase']}': {state['blocked']['reason']}")
        return 0
    live = [
        f"{key} ({loop['rounds']}/{loop['limit']})"
        for key, loop in state.get("loops", {}).items()
        if loop["rounds"] < loop["limit"]
    ]
    done = ", ".join(state.get("phases_done", [])) or "none"
    print(
        f"workflow '{state['workflow']}' is at phase '{state['phase']}'. "
        f"Completed: {done}. Open loops: {', '.join(live) or 'none'}."
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="okdev-state", description=__doc__)
    parser.add_argument("--root", default=os.environ.get("OKDEV_PROJECT", "."),
                        help="project root containing .okdev/ (default: cwd)")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("init", help="create run state, or print it if it already exists")
    p.add_argument("--workflow", required=True)
    p.add_argument("--phase", default="start")
    p.add_argument("--force", action="store_true", help="discard existing state")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("get", help="print the whole state or one dotted key")
    p.add_argument("key", nargs="?")
    p.set_defaults(func=cmd_get)

    p = sub.add_parser("set-phase", help="move to a new phase")
    p.add_argument("phase")
    p.set_defaults(func=cmd_set_phase)

    p = sub.add_parser("loop-bump", help="count a round; exits 3 when the budget is spent")
    p.add_argument("key")
    p.add_argument("--limit", type=int, required=True)
    p.set_defaults(func=cmd_loop_bump)

    p = sub.add_parser("loop-reset", help="clear a loop counter")
    p.add_argument("key")
    p.set_defaults(func=cmd_loop_reset)

    p = sub.add_parser("note", help="record a fact that must survive compaction")
    p.add_argument("key")
    p.add_argument("value")
    p.set_defaults(func=cmd_note)

    p = sub.add_parser("block", help="record a terminal blocked state and write blocked.md")
    p.add_argument("reason")
    p.set_defaults(func=cmd_block)

    p = sub.add_parser("complete", help="mark the workflow finished")
    p.add_argument("--workflow", help="this skill's own name; keeps a worker from "
                                      "completing an orchestrator's workflow")
    p.set_defaults(func=cmd_complete)

    p = sub.add_parser("next", help="print where the workflow stands")
    p.set_defaults(func=cmd_next)

    args = parser.parse_args()
    return args.func(Path(args.root).resolve(), args)


if __name__ == "__main__":
    sys.exit(main())
