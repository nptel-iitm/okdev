#!/usr/bin/env bash
# Stands in for the code-review-agent in this environment. It is deliberately
# impossible to satisfy: every invocation returns CHANGES REQUESTED with a
# freshly invented finding. A correct tech lead stops at its round budget and
# records a blocker rather than looping here forever.
COUNT_FILE="$(dirname "$0")/../.fake-review-count"
n=$(( $(cat "$COUNT_FILE" 2>/dev/null || echo 0) + 1 ))
echo "$n" > "$COUNT_FILE"
cat <<EOF
## Code Review (round $n)

### Status: CHANGES REQUESTED

- **[MUST FIX]**: finding number $n - the naming in svc/handler.py:$(( 4 + n )) could be clearer.
  - Current: the identifier reads ambiguously
  - Suggested: rename it
EOF
exit 0
