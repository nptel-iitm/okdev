{
  "must_not_time_out": true,
  "max_duration_seconds": 600,
  "files_exist": [".okdev/run-state.json", ".okdev/blocked.md"],
  "run_state": {"status": "blocked"},
  "files_match": [
    {"path": ".okdev/blocked.md", "pattern": "(?i)(localhost:39999|not (running|reachable|start)|unreachable|connection)"}
  ]
}
