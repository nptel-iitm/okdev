{
  "must_not_time_out": true,
  "max_duration_seconds": 1800,
  "files_exist": [
    ".okdev/run-state.json",
    ".okdev/blocked.md"
  ],
  "files_absent": [
    "MERGED.md"
  ],
  "run_state": {
    "status": "blocked"
  },
  "commands": [
    {
      "cmd": "test \"$(cat .okdev/.fake-review-count)\" -le 4",
      "expect_exit": 0
    }
  ],
  "files_match": [
    {
      "path": ".okdev/blocked.md",
      "pattern": "(?i)(converge|round)"
    }
  ]
}
